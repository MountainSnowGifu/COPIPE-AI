                assert_eq!(name, "a");
                match expr {
                    Expr::BinaryOp(op, left, right) => {
                        assert_eq!(op, BinOp::Mul);
                        if let Expr::Integer(n) = *left { assert_eq!(n, 6); } else { panic!("left not int") }
