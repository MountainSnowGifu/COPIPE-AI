use crate::lexer::{Lexer, Token};

#[derive(Debug, Clone)]
pub enum Expr {
    Number(i64),
    Ident(String),
    Binary {
        op: Token,
        left: Box<Expr>,
        right: Box<Expr>,
    },
}

pub struct Parser<'a> {
    lexer: Lexer,
    cur_token: Token,
    input: &'a str,
}

impl<'a> Parser<'a> {
    pub fn new(input: &'a str) -> Self {
        let mut lexer = Lexer::new(input);
        let first = lexer.next_token();
        Self {
            lexer,
            cur_token: first,
            input,
        }
    }

    fn advance(&mut self) {
        self.cur_token = self.lexer.next_token();
    }

    pub fn parse_expr(&mut self) -> Expr {
        self.parse_term()
    }

    fn parse_term(&mut self) -> Expr {
        let mut node = self.parse_factor();

        loop {
            match self.cur_token {
                Token::Plus | Token::Minus => {
                    let op = self.cur_token.clone();
                    self.advance();
                    let rhs = self.parse_factor();
                    node = Expr::Binary {
                        op,
                        left: Box::new(node),
                        right: Box::new(rhs),
                    };
                }
                _ => break,
            }
        }

        node
    }

    fn parse_factor(&mut self) -> Expr {
        let mut node = self.parse_primary();

        loop {
            match self.cur_token {
                Token::Star | Token::Slash => {
                    let op = self.cur_token.clone();
                    self.advance();
                    let rhs = self.parse_primary();
                    node = Expr::Binary {
                        op,
                        left: Box::new(node),
                        right: Box::new(rhs),
                    };
                }
                _ => break,
            }
        }

        node
    }

    fn parse_primary(&mut self) -> Expr {
        match self.cur_token.clone() {
            Token::Number(n) => {
                self.advance();
                Expr::Number(n)
            }
            Token::Ident(s) => {
                self.advance();
                Expr::Ident(s)
            }
            Token::LParen => {
                self.advance();
                let expr = self.parse_expr();
                if let Token::RParen = self.cur_token {
                    self.advance();
                }
                expr
            }
            _ => panic!("Unexpected token: {:?}", self.cur_token),
        }
    }
}

