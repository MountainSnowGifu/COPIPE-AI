        let src = "let a = 6 * 7\nlet b = a / 2\nif b > 10 then\n  let c = 1\nend if\n";
        let mut lx = Lexer::new(src);
        let mut parser = Parser::new(&mut lx);
        let prog = parser.parse_program();

