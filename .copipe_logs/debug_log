use std::io;

fn main() {
    println!("Rust 電卓アプリ");
    println!("例: 2 + 3");

    loop {
        println!("式を入力してください（例: 4 * 5）。終了するには exit と入力:");

        let mut input = String::new();
        io::stdin().read_line(&mut input).expect("入力エラー");
        let input = input.trim();

        if input.eq_ignore_ascii_case("exit") {
            println!("終了します。");
            break;
        }

        let tokens: Vec<&str> = input.split_whitespace().collect();
        if tokens.len() != 3 {
            println!("形式が正しくありません。例: 3 + 4");
            continue;
        }

        let a: f64 = match tokens[0].parse() {
            Ok(v) => v,
            Err(_) => {
                println!("左辺が数値ではありません。");
                continue;
            }
        };

        let op = tokens[1];

        let b: f64 = match tokens[2].parse() {
            Ok(v) => v,
            Err(_) => {
                println!("右辺が数値ではありません。");
                continue;
            }
        };

        let result = match op {
            "+" => a + b,
            "-" => a - b,
            "*" => a * b,
            "/" => {
                if b == 0.0 {
                    println!("0 で割ることはできません。");
                    continue;
                }
                a / b
            }
            _ => {
                println!("未対応の演算子です: {}", op);
                continue;
            }
        };

        println!("結果: {}", result);
    }
}

